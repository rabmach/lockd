#!/usr/bin/env bash
# lockd — lazy, kind encryption for regular humans. age underneath.
#
# The deal (announced in the literature, kept by the code):
#   * encrypt a file or directory with ONE word: `lockd`
#   * the passphrase you type unlocks your default key (created for you
#     the first time, if you don't have one)
#   * the original is wiped BY DEFAULT - but only after the ciphertext
#     is decrypted back and byte-verified against the original. If
#     verification fails, the original survives and lockd says so loudly.
#     `--keep` skips the wipe entirely.
#   * "no other options going forward" on the password window (or
#     `--fast`) makes lockd get out of your face: encrypt, verify, wipe,
#     done. `--full` overrides it for one run. The choice is remembered.
#
# Portability: lockd is not married to any desktop. Dialogs go through a
# backend chain: $LOCKD_DIALOG (override) -> yad -> zenity -> kdialog ->
# a plain terminal mode (read from stdin, which also makes lockd work
# over ssh and on a bare console). Clipboard: wl-copy -> xclip -> xsel.
# Mailer: $LOCKD_MAILER -> xdg-email -> claws-mail.
#
# Scoping: v1. Email signing/encryption + contact-card key sharing are
# phase 2. Name note: the kernel's NFS lock daemon owns the string
# `lockd` in some contexts (man lockd on NFS boxes) - accepted.

set -euo pipefail

CONFIG_DIR="${HOME}/.config/lockd"
CONFIG="${CONFIG_DIR}/config"
IDENTITY="${CONFIG_DIR}/identity.txt"

KEEP=0; FAST_RUN=0; FULL_RUN=0; DECRYPT=0; OPEN=0; SHRED_MODE=0
FAST_PATH=0        # loaded from config
NEW_KEY=0
VFDIR=""           # current verify workspace (trap cleans it on any exit)
STAGE=""           # current decrypt-restore staging (trap cleans on crash)
RESTORED=""        # last thing decrypt put back on disk (for --open)
TMPID=""           # unlocked temp identity + its dir (trap shreds on any
                   # exit). must be a GLOBAL: the EXIT trap fires after the
                   # flow functions return, and their locals are gone by
                   # then (field-found 2026-09-05: local tmpid meant the
                   # trap always hit 'unbound variable' - every run exited
                   # rc=1 and the unlocked key was never shredded)
DLG=""             # resolved dialog backend ("" until dlg_backend runs)

say()  { printf '%s\n' "$*"; }
notify() {  # GUI runs have no stdout - speak through the desktop instead
    # optional first arg: "-t MS" (notify-send expire timeout, milliseconds)
    local -a to=()
    if [[ "${1:-}" == "-t" ]]; then to=(-t "$2"); shift 2; fi
    [[ -n "${DISPLAY:-}" ]] && command -v notify-send >/dev/null \
        && notify-send "${to[@]+${to[@]}}" --hint=int:transient:1 "lockd" "$*" 2>/dev/null || true
}
need() { command -v "$1" >/dev/null || die "missing: $1"; }

# ---------- dialog backend layer ----------
# resolved once per run. tty mode reads the terminal (stdin), so the
# whole flow - key birth included - works over ssh with no GUI at all.
dlg_backend() {
    [[ -n "$DLG" ]] && return 0
    local want="${LOCKD_DIALOG:-}"
    if [[ -n "$want" ]]; then
        if [[ "$want" == tty ]]; then DLG="tty"
        elif command -v "$want" >/dev/null 2>&1; then DLG="$want"
        else
            printf 'lockd: LOCKD_DIALOG=%s not installed - using terminal mode\n' "$want" >&2
            DLG="tty"
        fi
        return 0
    fi
    if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        local c
        for c in yad zenity kdialog; do
            command -v "$c" >/dev/null 2>&1 && { DLG="$c"; return 0; }
        done
    fi
    DLG="tty"
}

# ask passphrase + confirm + fast-path checkbox.
# -> three lines on stdout: passphrase, confirm, TRUE|FALSE. rc!=0 = cancelled.
# (zenity forms and kdialog passwords have no checkbox - the fast path
# becomes a follow-up question there, as agreed.)
# NOTE: fields are newline-separated, so passwords may contain | and ;
# (a password with a literal newline is still out of scope everywhere).
dlg_form() {
    dlg_backend
    local NL=$'\n' out chk
    case "$DLG" in
        yad)
            out=$(yad --title="lockd" --borders=12 --form --separator="$NL" \
                --field="Passphrase:":H --field="  (confirm):":H \
                --field="No other options going forward:":CHK 2>/dev/null) || return 1 ;;
        zenity)
            out=$(zenity --forms --title="lockd" --separator="$NL" \
                --add-password="Passphrase" --add-password="  (confirm)" 2>/dev/null) || return 1
            chk=FALSE
            # zenity's form has no checkbox widget - the fast-path choice
            # becomes a follow-up question, asked ONCE per key lifetime.
            # after that: one window, creds, enter, bam.
            if [[ $(config_get fast_path) != "1" && $(config_get fastpath_asked) != "1" ]]; then
                zenity --question --title="lockd" \
                    --text="No other options going forward?\n(yes: encrypt, verify, done - this is asked only once)" 2>/dev/null && chk=TRUE
                config_set fastpath_asked 1
            fi
            out+="${NL}${chk}" ;;
        kdialog)
            local p1 p2
            p1=$(kdialog --title lockd --password "Passphrase" 2>/dev/null) || return 1
            p2=$(kdialog --title lockd --password "  (confirm)" 2>/dev/null) || return 1
            chk=FALSE
            if [[ $(config_get fast_path) != "1" && $(config_get fastpath_asked) != "1" ]]; then
                kdialog --title lockd --yesno "No other options going forward? (yes: encrypt, verify, done - asked only once)" 2>/dev/null && chk=TRUE
                config_set fastpath_asked 1
            fi
            out="${p1}${NL}${p2}${NL}${chk}" ;;
        tty)
            local p1 p2 a
            read -rs -p "lockd passphrase: " p1 || return 1; printf '\n' >&2
            read -rs -p "  (confirm): " p2 || return 1; printf '\n' >&2
            read -r  -p "No other options going forward? [y/N] " a || a=""
            chk=FALSE; [[ "$a" == y* ]] && chk=TRUE
            out="${p1}${NL}${p2}${NL}${chk}" ;;
        *) return 1 ;;
    esac
    if [[ "$out" != *$'\n'* ]]; then return 1; fi   # a form always has >= 2 fields
    printf '%s' "$out"
}

dlg_note() {  # info window (tty: plain line); best-effort, never fatal
    dlg_backend
    case "$DLG" in
        yad)     yad --title="lockd" --borders=12 --info --text="$*" --width=420 2>/dev/null || true ;;
        zenity)  zenity --info --title="lockd" --text="$*" 2>/dev/null || true ;;
        kdialog) kdialog --title lockd --msgbox "$*" 2>/dev/null || true ;;
        tty)     printf '%b\n' "lockd: $*" >&2 ;;   # stderr: stdout carries form data
    esac
}

dlg_creds() {  # passphrase + confirm (+ fastpath flag), with immediate fix-up.
  # a mismatch or an empty pair does NOT kick you out of the flow: the form
  # re-shows right away. after three strikes, lockd says the thing:
  # no, man - you should NOT call her. move on. get a grip. focus.
  # (figured it will resonate with ~44% of the user base)
  # -> three lines on stdout: passphrase, confirm, TRUE|FALSE. rc!=0 = give up.
  local attempt out f upw cpw chk
  for attempt in 1 2 3; do
      out=$(dlg_form) || return 1
      mapfile -t f <<<"$out"
      upw="${f[0]:-}"; cpw="${f[1]:-}"; chk="${f[2]:-FALSE}"
      if [[ -n "$upw" && "$upw" == "$cpw" ]]; then
          printf '%s' "$out"
          return 0
      fi
      if (( attempt < 3 )); then
          if [[ -z "$upw" ]]; then
              dlg_note "Empty passphrase. Once more: type it in both lines."
          else
              dlg_note "Those two lines did not match. Once more - slow, this time.\n(attempt ${attempt} of 3)"
          fi
      fi
  done
  dlg_note "No, man - you should NOT call her.\nMove on. Get a grip. And focus."
  return 1
}

die() {  # stderr always; GUI backends also get a window
    printf 'lockd: %s\n' "$*" >&2
    dlg_backend
    if [[ "$DLG" != "tty" ]]; then dlg_err "$*"; fi
    exit 1
}

dlg_err() {  # error dialog (tty: stderr, already covered by die)
    dlg_backend
    case "$DLG" in
        yad)     yad --title="lockd" --borders=12 --error --text="$*" --width=420 2>/dev/null || true ;;
        zenity)  zenity --error --title="lockd" --text="$*" 2>/dev/null || true ;;
        kdialog) kdialog --title lockd --error "$*" 2>/dev/null || true ;;
    esac
}

dlg_q() {  # question; rc 0 = yes
    dlg_backend
    case "$DLG" in
        yad)     yad --title="lockd" --borders=12 --question --text="$*" --width=420 2>/dev/null ;;
        zenity)  zenity --question --title="lockd" --text="$*" 2>/dev/null ;;
        kdialog) kdialog --title lockd --yesno "$*" 2>/dev/null ;;
        tty)     local a; read -r -p "lockd: $* [y/N] " a || return 1; [[ "$a" == y* ]] ;;
        *)       return 1 ;;
    esac
}

dlg_pick() {  # $1 title, $2 optional "name | *.ext" filter -> paths on stdout
    dlg_backend
    local title="$1" filter="${2:-}"
    case "$DLG" in
        yad)
            if [[ -n "$filter" ]]; then
                yad --title="$title" --borders=12 --file-selection --multiple \
                    --separator='\n' --width=720 --file-filter="$filter" 2>/dev/null || true
            else
                yad --title="$title" --borders=12 --file-selection --multiple \
                    --separator='\n' --width=720 2>/dev/null || true
            fi ;;
        zenity)
            if [[ -n "$filter" ]]; then
                zenity --file-selection --multiple --separator='\n' --title="$title" \
                    --file-filter="$filter" 2>/dev/null || true
            else
                zenity --file-selection --multiple --separator='\n' --title="$title" 2>/dev/null || true
            fi ;;
        kdialog)
            # kdialog wants "pattern|description" (sides swapped vs yad/zenity)
            local f="*|All files"
            [[ -n "$filter" ]] && f="${filter#*| }|${filter% |*}"
            kdialog --title "$title" --getopenfilename "$PWD" "$f" \
                --multiple --separate-output 2>/dev/null || true ;;
        *)
            printf 'lockd: no file picker in terminal mode - pass paths as arguments\n' >&2
            return 0 ;;
    esac
}

dlg_list() {  # $1 title; rest = tag label pairs -> chosen tag on stdout
    dlg_backend
    local title="$1"; shift
    local -a args=()
    case "$DLG" in
        yad)
            args=(--list --hide-column=1 --column="id" --column="option"
                  --print-column=1 --width=520 --height=280)
            while (( $# )); do args+=("$1" "$2"); shift 2; done
            yad --title="$title" --borders=12 "${args[@]}" 2>/dev/null | cut -d'|' -f1 || true ;;
        zenity)
            args=(--list --hide-column=1 --column="id" --column="option" --print-column=1)
            while (( $# )); do args+=("$1" "$2"); shift 2; done
            zenity --title="$title" "${args[@]}" 2>/dev/null || true ;;
        kdialog)
            args=()
            while (( $# )); do args+=("$1" "$2"); shift 2; done
            kdialog --title "$title" --menu "$title" "${args[@]}" 2>/dev/null || true ;;
        tty)
            local -A map=() n=1
            while (( $# )); do
                printf '  %d) %s\n' "$n" "$2" >&2
                map[$n]="$1"; n=$((n+1)); shift 2
            done
            local a; read -r -p "#? " a || return 0
            [[ -n "${map[$a]:-}" ]] && printf '%s\n' "${map[$a]}"
            return 0 ;;
    esac
}

identity_path() {
    # config override -> stock lockd path. Also scanned for adoption:
    # ~/.config/age/keys.txt, ~/.config/sops/age/keys.txt, ~/.config/rage/identities
    local p; p=$(config_get identity_path)
    [[ -n "$p" ]] && { printf '%s' "$p"; return; }
    printf '%s' "$IDENTITY"
}

config_get() {
    [[ -f "$CONFIG" ]] && grep -E "^$1=" "$CONFIG" | tail -1 | cut -d= -f2- || true
}
config_set() {
    mkdir -p "$CONFIG_DIR"
    touch "$CONFIG"
    if grep -qE "^$1=" "$CONFIG" 2>/dev/null; then
        sed -i "s|^$1=.*|$1=$2|" "$CONFIG"
    else
        printf '%s=%s\n' "$1" "$2" >> "$CONFIG"
    fi
}

# unlock the passphrase-encrypted identity via a pty (age reads
# passphrases from the terminal only; script(1) provides the terminal).
# Returns 0 and echoes the temp plaintext-identity path on success.
# 2026-09-06: mismatch fix-up (dlg_creds) + wrong-passphrase retry (3
# strikes each) + the creds are unset the moment they are consumed -
# sometimes a typed passphrase is REAL; it should vanish the instant its
# work is done. (The earlier tty bug: dlg_note printed to stdout and got
# captured INTO the form data - the key could be born guarded by the
# warning text itself. Notes now speak on stderr only.)
lockd_slam() {  # three strikes; the reminder 44% of us know by heart
    dlg_note "No, man - you should NOT call her.\nMove on. Get a grip. And focus."
    return 1
}

unlock_identity() {
    local wdir tmpid attempt out ok=0
    wdir=$(mktemp -d "${TMPDIR:-/tmp}/lockd-id.XXXXXX")
    tmpid="$wdir/id"                       # must NOT exist: age refuses -o over
    chmod 600 "$tmpid" 2>/dev/null || true
    local f upw cpw chk
    local cmd
    cmd=$(printf 'age -d -o %q %q' "$tmpid" "$(identity_path)")
    for attempt in 1 2 3; do
        out=$(dlg_creds) || { rm -rf "$wdir"; exit 1; }  # dlg_creds already had the last word
        mapfile -t f <<<"$out"
        unset out
        upw="${f[0]:-}"; cpw="${f[1]:-}"; chk="${f[2]:-FALSE}"
        unset cpw f
        if [[ "$chk" == TRUE ]]; then config_set fast_path 1; fi
        unset chk
        if printf '%s\n' "$upw" | script -qfec "$cmd" /dev/null >/dev/null 2>&1; then
            unset upw
            ok=1
            break
        fi
        unset upw
        (( attempt < 3 )) && dlg_note "Wrong passphrase for that key. Once more.\n(attempt ${attempt} of 3)"
    done
    (( ok == 1 )) || { rm -rf "$wdir"; lockd_slam; exit 1; }
    # the unlocked file must contain a real secret key - catches corrupt
    # or wrong-file identities instead of failing later, mid-flow
    grep -q "AGE-SECRET-KEY-" "$tmpid" \
        || { shred -uzn1 "$tmpid" 2>/dev/null; rm -rf "$wdir"; die "identity file is not a valid age key"; }
    printf '%s' "$tmpid"
}

desktop_dir() {  # the DE's real Desktop (localized), else ~/Desktop. rc 1 = none
    local f="$HOME/.config/user-dirs.dirs" d=""
    if [[ -r "$f" ]]; then
        d=$(source "$f" 2>/dev/null; printf '%s' "${XDG_DESKTOP_DIR:-}")
    fi
    [[ -n "$d" && -d "$d" ]] && { printf '%s\n' "$d"; return 0; }
    [[ -d "$HOME/Desktop" ]] && { printf '%s\n' "$HOME/Desktop"; return 0; }
    return 1
}

backup_key_to_desktop() {  # $1 = identity file -> tarball path on stdout
    # One-time safeguard at key birth: the wrapped identity lands on the
    # Desktop as a dated tarball. Ciphertext is shareable by design (the
    # passphrase is the secret), but 600 costs nothing. Human lines go to
    # STDERR so command substitution only ever captures the path.
    local id="$1" d out n=1
    d=$(desktop_dir) \
        || { printf '%s\n' "no Desktop dir found - safeguard the key file itself: $id" >&2; return 1; }
    out="$d/lockd-key-$(date +%F).tar.gz"
    while [[ -e "$out" ]]; do          # never overwrite an earlier backup
        n=$((n + 1)); out="$d/lockd-key-$(date +%F)-$n.tar.gz"
    done
    if tar -czf "$out" -C "$(dirname "$id")" "$(basename "$id")" 2>/dev/null; then
        chmod 600 "$out" 2>/dev/null || true
        printf '%s\n' "$out"
        return 0
    fi
    rm -f "$out" 2>/dev/null || true
    printf '%s\n' "key backup to $d failed - safeguard the key file itself: $id" >&2
    return 1
}

STANDARD_KEY_SPOTS=(
    "${HOME}/.config/age/keys.txt"
    "${HOME}/.config/sops/age/keys.txt"
    "${HOME}/.config/rage/identities"
)

ensure_key() {
    local id; id=$(identity_path)
    [[ -f "$id" ]] && return 0
    # kind discovery: adopt an existing age key by reference (never copy
    # secrets around); standard spots first.
    for spot in "${STANDARD_KEY_SPOTS[@]}"; do
        if [[ -f "$spot" ]]; then
            if dlg_q "Found an existing age key:\n${spot}\n\nAdopt it as your lockd default? (referenced, not copied)"; then
                config_set identity_path "$spot"
                say "adopted: $spot"
                return 0
            fi
        fi
    done
    dlg_q "No default AGE key found.\n(gpg keys are a different system - they do not apply here.)\n\nCreate one now? It becomes your lockd default.\nLives at: ${IDENTITY}" \
        || die "no key, no lock"
    local out
    out=$(dlg_creds) || exit 1  # dlg_creds already had the last word
    local f npw cpw chk
    mapfile -t f <<<"$out"
    npw="${f[0]:-}"; cpw="${f[1]:-}"; chk="${f[2]:-FALSE}"
    [[ -n "$npw" ]] || die "empty passphrase"
    if [[ "$chk" == TRUE ]]; then config_set fast_path 1; fi
    mkdir -p "$CONFIG_DIR"
    local id; id=$(identity_path)
    local wdir; wdir=$(mktemp -d "${TMPDIR:-/tmp}/lockd-birth.XXXXXX")
    local plain; plain="$wdir/plain"       # non-existent: age writes fresh
    age-keygen -o "$plain" >/dev/null 2>&1 || { rm -rf "$wdir"; die "keygen failed"; }
    # BUG FIX 2026-09-03: the first version ran 'age -p -o ID' with NO input
    # file, so age encrypted STDIN - the passphrase lines themselves - and
    # called it an identity. Key birth must be: keygen to a plain file,
    # then encrypt THAT FILE (input as argument, passphrase via the pty).
    local cmd
    cmd=$(printf 'age -p -o %q %q' "$id" "$plain")
    printf '%s\n%s\n' "$npw" "$npw" | script -qfec "$cmd" /dev/null >/dev/null 2>&1 \
        || { rm -rf "$wdir"; unset npw cpw; die "key encryption failed"; }
    unset cpw     # confirm's work is done
    shred -uzn1 "$plain"
    [[ -f "$id" ]] || { rm -rf "$wdir"; die "key creation produced nothing"; }
    chmod 600 "$id"; chmod 700 "$CONFIG_DIR" 2>/dev/null || true
    # birth certificate: the locked file must actually CONTAIN a key
    local check; check="$wdir/check"
    cmd=$(printf 'age -d -o %q %q' "$check" "$id")
    printf '%s\n%s\n' "$npw" "$npw" | script -qfec "$cmd" /dev/null >/dev/null 2>&1 \
        && grep -q "AGE-SECRET-KEY-" "$check" \
        || { rm -rf "$wdir"; shred -uzn1 "$id" 2>/dev/null; unset npw; die "created key failed verification - nothing saved, run lockd again"; }
    unset npw    # the passphrase did its job; it leaves immediately
    rm -rf "$wdir"
    say "key created + verified: $id"
    # the one-time safeguard: a backup lands on the Desktop the moment the
    # key exists, and the user is told exactly once to protect it. These
    # users know they are wearing purple - no reminders, ever, after this.
    local bk
    if bk=$(backup_key_to_desktop "$id"); then
        say "backup: $bk - safeguard it (and the passphrase) now."
        ( sleep 6
          [[ -n "${DISPLAY:-}" ]] && command -v notify-send >/dev/null \
              && notify-send --hint=int:transient:1 -t 10000 "lockd" \
                 "key created. backup: $bk - safeguard it (and the passphrase) now."
        ) 2>/dev/null &
    fi
    NEW_KEY=1
}

usage() {
    cat <<'EOF'
lockd — lazy, kind encryption (age underneath)

  lockd [paths...]          encrypt files (or a directory: one archive)
  lockd --shred paths...    secure-wipe any file or directory tree.
                            no questions asked - it goes, and lockd
                            reports: "and just like that...gone"
  lockd -d paths...         decrypt .age files (originals of THIS run are
                            .age files; shredding them is offered, not forced)
                            directory archives restore the tree in place -
                            streamed, never overwriting, no archive residue
  lockd -k|--keep           encrypt but never wipe the originals
  lockd -f|--fast           this run: no send/extra offers
  lockd --full              this run: offers even if fast-path is saved
  lockd --selftest          crypto roundtrip + backend/clipboard checks, headless

Wipe rule: originals are shredded BY DEFAULT, but only after the
ciphertext verifies byte-for-byte. If verification fails, the original
survives and lockd says so. "No other options going forward" on the
password window saves the fast path permanently.

Any desktop, or none:
  $LOCKD_DIALOG   force a dialog backend: yad, zenity, kdialog, or tty.
                  default: yad -> zenity -> kdialog -> terminal.
                  terminal mode reads stdin, so lockd works over ssh too.
  $LOCKD_MAILER   mailer for the "email it" offer (else xdg-email, then
                  claws-mail). attachments via --attach.
EOF
}

print_ctx_script() {  # right-click script for the nautilus/caja/nemo family
    # one body, three managers: they all speak the nautilus script protocol
    # (selection in *_SCRIPT_SELECTED_FILE_PATHS, newline-separated). the
    # installer drops it under each manager's scripts dir; selftest proves
    # the env -> argv plumbing (spaces included) with a stub lockd.
    local kind="$1" exec_line
    case "$kind" in
        encrypt) exec_line="lockd" ;;
        decrypt) exec_line="lockd -d --open" ;;
        shred)   exec_line="lockd --shred" ;;
        *) return 1 ;;
    esac
    cat <<EOF
#!/bin/sh
# lockd — $kind (nautilus / caja / nemo right-click)
sel="\${NEMO_SCRIPT_SELECTED_FILE_PATHS:-\${CAJA_SCRIPT_SELECTED_FILE_PATHS:-\${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}}}"
while IFS= read -r f; do
    [ -n "\$f" ] && set -- "\$@" "\$f"
done <<LOCKD_PATHS
\$sel
LOCKD_PATHS
exec $exec_line "\$@"
EOF
}

do_selftest() {
    local t; t=$(mktemp -d "${TMPDIR:-/tmp}/lockd-selftest.XXXXXX")
    # set +e: the trap runs under errexit, and shred errors on any
    # directory in its path - without it the trap dies mid-way, rm -rf
    # never runs, and the failure code REPLACES the test result (this
    # shipped once: PASS on screen, rc=1 to callers, dir leaked)
    trap "set +e; find '$t' -type f -exec shred -uzn1 {} + 2>/dev/null; rm -rf '$t'" EXIT
    printf 'lockd selftest payload %s\n' "$(date)" > "$t/plain.txt"
    # identity for the test (unencrypted temp; no passphrase machinery)
    AGE_IDENTITY="$t/testkey.txt" age-keygen -o "$t/testkey.txt" >/dev/null 2>&1
    local pub; pub=$(AGE_IDENTITY="$t/testkey.txt" age-keygen -y "$t/testkey.txt")
    # encrypt -> verify -> shred -> decrypt -> compare
    age -r "$pub" -o "$t/plain.txt.age" "$t/plain.txt"
    [[ -f "$t/plain.txt.age" ]] || { echo "FAIL: no ciphertext"; return 1; }
    age -d -i "$t/testkey.txt" -o "$t/verify.txt" "$t/plain.txt.age"
    cmp -s "$t/plain.txt" "$t/verify.txt" || { echo "FAIL: roundtrip mismatch"; return 1; }
    shred -uzn1 "$t/plain.txt"
    [[ ! -e "$t/plain.txt" ]] || { echo "FAIL: shred left the original"; return 1; }
    age -d -i "$t/testkey.txt" -o "$t/roundtrip.txt" "$t/plain.txt.age"
    grep -q "lockd selftest payload" "$t/roundtrip.txt" || { echo "FAIL: content"; return 1; }
    # directory roundtrip: tar|age -> unpack + tree-diff (the verify path
    # directories actually take)
    mkdir -p "$t/dir/sub"
    printf 'dir payload\n' > "$t/dir/top.txt"
    printf 'nested payload\n' > "$t/dir/sub/deep.txt"
    tar -C "$t" -czf - dir | age -r "$pub" -o "$t/dir.age"
    [[ -s "$t/dir.age" ]] || { echo "FAIL: no directory ciphertext"; return 1; }
    age -d -i "$t/testkey.txt" -o "$t/dirverify.tar.gz" "$t/dir.age"
    mkdir -p "$t/x"
    tar -xzf "$t/dirverify.tar.gz" -C "$t/x"
    diff -r -q --no-dereference "$t/dir" "$t/x/dir" >/dev/null \
        || { echo "FAIL: directory roundtrip mismatch"; return 1; }

    # --- backend walk: override honored, bad override falls back, no
    # dialog binaries -> tty (bash-only PATH), real backends detectable
    local b
    b=$(LOCKD_DIALOG=tty "$0" --print-backend) && [[ "$b" == "tty" ]] \
        || { echo "FAIL: LOCKD_DIALOG=tty not honored"; return 1; }
    b=$(LOCKD_DIALOG=definitely-not-real-"$$" "$0" --print-backend 2>/dev/null) && [[ "$b" == "tty" ]] \
        || { echo "FAIL: bad override should fall back to tty"; return 1; }
    mkdir -p "$t/bin" && ln -sf "$(command -v bash)" "$t/bin/bash"
    b=$(PATH="$t/bin" "$0" --print-backend) && [[ "$b" == "tty" ]] \
        || { echo "FAIL: no dialog binaries should mean tty"; return 1; }
    if command -v yad >/dev/null 2>&1; then
        b=$(LOCKD_DIALOG=yad "$0" --print-backend) && [[ "$b" == "yad" ]] \
            || { echo "FAIL: LOCKD_DIALOG=yad not honored"; return 1; }
    fi
    if command -v zenity >/dev/null 2>&1; then
        b=$(LOCKD_DIALOG=zenity "$0" --print-backend) && [[ "$b" == "zenity" ]] \
            || { echo "FAIL: LOCKD_DIALOG=zenity not honored"; return 1; }
    fi

    # --- clipboard chain: present-but-failing helper falls through to
    # the next one (stub wl-copy exits 1, stub xclip captures stdin)
    mkdir -p "$t/stub"
    printf '#!/bin/sh\nexit 1\n' > "$t/stub/wl-copy"
    printf '#!/bin/sh\ncat > "$LOCKD_STUB_OUT"\n' > "$t/stub/xclip"
    chmod +x "$t/stub/wl-copy" "$t/stub/xclip"
    ( export PATH="$t/stub:$PATH" LOCKD_STUB_OUT="$t/clip.out"
      printf 'clip-payload' | clip_copy ) || { echo "FAIL: clipboard chain fell through"; return 1; }
    grep -q "clip-payload" "$t/clip.out" || { echo "FAIL: clipboard payload lost"; return 1; }
    rm -f "$t/stub/xclip"
    mkdir -p "$t/stub2" && ln -sf "$(command -v bash)" "$t/stub2/bash"
    mv -f "$t/stub/wl-copy" "$t/stub2/wl-copy" 2>/dev/null || true
    ( export PATH="$t/stub2"; printf 'x' | clip_copy ) 2>/dev/null \
        && { echo "FAIL: dead clipboard chain should fail"; return 1; } || true

    # --- right-click scripts: env -> argv plumbing (spaces intact) via
    # a stub lockd on PATH
    mkdir -p "$t/bin2"
    cat > "$t/bin2/lockd" <<'STUB'
#!/bin/sh
printf '%s\n' "$@" > "$LOCKD_CTX_OUT"
STUB
    chmod +x "$t/bin2/lockd"
    "$0" --ctx-script encrypt > "$t/ctx.sh"
    ( export PATH="$t/bin2:$PATH" LOCKD_CTX_OUT="$t/ctx.out"
      export NAUTILUS_SCRIPT_SELECTED_FILE_PATHS="$t/a file.txt"$'\n'"$t/b.txt"
      sh "$t/ctx.sh" )
    grep -qxF "$t/a file.txt" "$t/ctx.out" && grep -qxF "$t/b.txt" "$t/ctx.out" \
        || { echo "FAIL: ctx script mangled paths"; return 1; }
    "$0" --ctx-script decrypt | grep -q "lockd -d --open" \
        || { echo "FAIL: decrypt ctx script wrong"; return 1; }

    # --- no residue, ever + WILL decrypt: the REAL flow (key birth,
    # encrypt, verify-wipe, decrypt) in an isolated HOME+TMPDIR. The
    # trap-cleaned temp identity must leave TMPDIR empty, and the payload
    # must come back byte-perfect. (running "$0" as its own process: its
    # traps fire in ITS lifetime, exactly like a real user run)
    mkdir -p "$t/iso" "$t/isotmp"
    ( export HOME="$t/iso" TMPDIR="$t/isotmp" LOCKD_DIALOG=tty
      printf 'residue payload\n' > "$t/iso/doc.txt"
      printf 'y\nselfpw\nselfpw\ny\nselfpw\nselfpw\ny\n' | "$0" "$t/iso/doc.txt" >/dev/null 2>&1
      printf 'selfpw\nselfpw\nn\n' | "$0" -d "$t/iso/doc.txt.age" >/dev/null 2>&1
    )
    grep -q "residue payload" "$t/iso/doc.txt" \
        || { echo "FAIL: flow did not decrypt the payload back"; return 1; }
    [[ -f "$t/iso/doc.txt.age" ]] \
        || { echo "FAIL: .age missing (user declined source-shred - it must stay)"; return 1; }
    local res; res=$(ls -A "$t/isotmp" 2>/dev/null | wc -l)
    [[ "$res" -eq 0 ]] \
        || { echo "FAIL: residue left behind: $(ls -A "$t/isotmp" | tr '\n' ' ')"; return 1; }

    # --- the Desktop backup + the restore story: backup -> destroy ->
    # restore -> decrypt, THEN restore with hostile metadata (1999 mtime,
    # 777 perms) -> still decrypts. age reads bytes; timestamps and
    # permissions play no part in decryption. Machine-checked forever so
    # the "cp it back into a fresh install" promise can never silently rot.
    mkdir -p "$t/home/.config/lockd" "$t/home/Desktop"
    local wrapcmd; wrapcmd=$(printf 'age -p -o %q %q' \
        "$t/home/.config/lockd/identity.txt" "$t/testkey.txt")
    printf 'selftestpw\nselftestpw\n' | script -qfec "$wrapcmd" /dev/null >/dev/null 2>&1 \
        || { echo "FAIL: could not build wrapped identity for backup test"; return 1; }
    local bk
    bk=$(HOME="$t/home" backup_key_to_desktop "$t/home/.config/lockd/identity.txt") \
        || { echo "FAIL: Desktop backup skipped"; return 1; }
    [[ -f "$bk" && -s "$bk" ]] \
        || { echo "FAIL: backup tarball missing or empty"; return 1; }
    rm -f "$t/home/.config/lockd/identity.txt"
    mkdir -p "$t/restore"
    tar -xzf "$bk" -C "$t/restore" || { echo "FAIL: backup tarball unreadable"; return 1; }
    local rt1cmd; rt1cmd=$(printf 'age -d -i %q -o %q %q' "$t/restore/identity.txt" "$t/rt1.txt" "$t/plain.txt.age")
    printf 'selftestpw\n' | script -qfec "$rt1cmd" /dev/null >/dev/null 2>&1
    cmp -s "$t/roundtrip.txt" "$t/rt1.txt" \
        || { echo "FAIL: restored key did not decrypt the payload"; return 1; }
    # hostile metadata: the copy-back with every filemarker wrong
    touch -d "1999-01-01 00:00:00" "$t/restore/identity.txt"
    chmod 777 "$t/restore/identity.txt"
    cp -f "$t/restore/identity.txt" "$t/home/.config/lockd/identity.txt"
    local rt2cmd; rt2cmd=$(printf 'age -d -i %q -o %q %q' "$t/home/.config/lockd/identity.txt" "$t/rt2.txt" "$t/plain.txt.age")
    printf 'selftestpw\n' | script -qfec "$rt2cmd" /dev/null >/dev/null 2>&1
    cmp -s "$t/roundtrip.txt" "$t/rt2.txt" \
        || { echo "FAIL: hostile-metadata copy-back did not decrypt"; return 1; }

    echo "selftest: PASS (file + directory roundtrips, wipe semantics, backend walk, clipboard chain, ctx scripts, real-flow decrypt + zero residue, backup-restore incl. hostile metadata)"
}

pick_files() {  # -> paths on stdout (empty on cancel)
    dlg_pick "lockd — pick what to encrypt"
}

clip_copy() {  # stdin -> system clipboard; wayland, x11, then xsel
    # stdio goes to /dev/null: xclip forks a daemon to hold the selection,
    # and a daemon holding our stdout is a hang waiting to happen
    local c
    for c in wl-copy xclip xsel; do
        command -v "$c" >/dev/null 2>&1 || continue
        case "$c" in
            wl-copy) wl-copy >/dev/null 2>&1 && return 0 ;;
            xclip)   xclip -selection clipboard >/dev/null 2>&1 && return 0 ;;
            xsel)    xsel --clipboard --input >/dev/null 2>&1 && return 0 ;;
        esac
    done
    return 1
}

mail_attach() {  # attach files: $LOCKD_MAILER -> xdg-email -> claws-mail
    (( $# > 0 )) || return 1
    local -a cmd=()
    if [[ -n "${LOCKD_MAILER:-}" ]]; then
        command -v "$LOCKD_MAILER" >/dev/null 2>&1 \
            || { say "LOCKD_MAILER=$LOCKD_MAILER not installed"; return 1; }
        cmd=("$LOCKD_MAILER")
    elif command -v xdg-email >/dev/null 2>&1; then cmd=(xdg-email)
    elif command -v claws-mail >/dev/null 2>&1; then cmd=(claws-mail)
    else return 1; fi
    local f
    for f in "$@"; do cmd+=("--attach=$f"); done
    "${cmd[@]}" >/dev/null 2>&1 & disown || true
    say "mail draft opened with $# encrypted file(s) attached (${cmd[0]})"
}

places_list() {  # -> deduped bookmark dirs: GTK bookmarks + KDE user-places.xbel
    local f p
    {   f="${HOME}/.config/gtk-3.0/bookmarks"
        [[ -f "$f" ]] && while IFS= read -r p; do
            p="${p#file://}"; p="${p%% *}"; p="${p//%20/ }"
            [[ -d "$p" ]] && printf '%s\n' "$p"
        done < "$f"
        # Dolphin/Plasma places are an XBEL file; hrefs are file:// URLs.
        # (decode is intentionally rough: %20 only - spaces cover real bookmarks)
        f="${HOME}/.local/share/user-places.xbel"
        if [[ -f "$f" ]]; then
            while IFS= read -r p; do
                p="${p#file://}"; p="${p//%20/ }"
                [[ -d "$p" ]] && printf '%s\n' "$p"
            done < <(grep -o 'href="[^"]*"' "$f" | sed 's/^href="//; s/"$//')
        fi
    } | awk '!seen[$0]++'
}

send_offers() {
    [[ $FAST_RUN -eq 1 ]] && return 0
    [[ $(config_get fast_path) == "1" ]] && return 0
    local pub="$1"; shift
    local choice
    choice=$(dlg_list "lockd — what now?" \
        pub    "Copy public key to clipboard" \
        email  "Email the encrypted file(s)" \
        place  "Copy to a Place (your bookmarks)" \
        done   "Done") || choice=""
    case "$choice" in
        pub)
            if printf '%s' "$pub" | clip_copy; then
                say "public key copied to clipboard"
            else
                dlg_err "no clipboard helper found (wl-copy / xclip / xsel)\nYour public key:\n$pub"
                say "no clipboard helper - public key:\n$pub"
            fi ;;
        email)
            mail_attach "$@" || { dlg_err "no mailer found\n(set \$LOCKD_MAILER, or install xdg-email / claws-mail)"; say "no mailer found"; } ;;
        place)
            local -a places=()
            mapfile -t places < <(places_list)
            if (( ${#places[@]} == 0 )); then
                say "no bookmarks (places) found"
                return 0
            fi
            local -a pargs=() pl
            for pl in "${places[@]}"; do pargs+=("$pl" "$(basename "$pl")"); done
            local pick
            pick=$(dlg_list "lockd — pick a Place" "${pargs[@]}") || pick=""
            if [[ -n "$pick" && -d "$pick" ]]; then
                local f
                for f in "$@"; do cp -v "$f" "$pick/"; done
                say "copied to Place: $pick"
            fi ;;
    esac
}

cleanup_ids() {  # shred the unlocked temp identity + remove its workdir
    [[ -n "${TMPID:-}" ]] || return 0
    shred -uzn1 "$TMPID" 2>/dev/null || true
    rmdir "$(dirname "$TMPID")" 2>/dev/null || true
    TMPID=""
}

do_encrypt() {
    need age; need age-keygen
    ensure_key
    TMPID=$(unlock_identity)
    trap 'cleanup_ids; [[ -n "${VFDIR:-}" ]] && rm -rf "${VFDIR}"; [[ -n "${STAGE:-}" ]] && rm -rf "${STAGE}"; VFDIR=""; STAGE=""' EXIT
    local pub; pub=$(age-keygen -y "$TMPID")

    local paths=("$@")
    if (( ${#paths[@]} == 0 )); then
        mapfile -t paths < <(pick_files)
        (( ${#paths[@]} > 0 )) || die "nothing picked"
    fi

    local made=() p out base
    for p in "${paths[@]}"; do
        [[ -e "$p" ]] || { say "skip: $p (missing)"; continue; }
        if [[ -d "$p" ]]; then
            base="$(basename "$p").tar.gz.age"
            out="$(dirname "$p")/$base"
            tar -C "$(dirname "$p")" -czf - "$(basename "$p")" \
                | age -r "$pub" -o "$out"
        else
            out="${p}.age"
            age -r "$pub" -o "$out" "$p"
        fi
        [[ -s "$out" ]] || { dlg_err "encryption produced nothing: $out"; return 1; }
        # verify-then-shred: the wipe rule can never lie. Files byte-compare;
        # directories unpack the archive and diff the whole tree (a tar.gz
        # can never byte-compare against a directory - BUG FIX 2026-09-04:
        # directory encrypts always failed verification and shredded the
        # good ciphertext).
        # verify workspace lives NEXT TO THE CIPHERTEXT, not /tmp: many
        # boxes have a small /tmp partition (this one: 921MB), and an
        # ENOSPC mid-chain dies invisibly behind 2>/dev/null, misreporting
        # as verification failure (BUG FIX 2026-09-04, field-found on a
        # 1.4G directory). Pre-flight: the verify needs ~3x the payload
        # (ciphertext + decrypted copy + extracted tree) - say so BEFORE
        # encrypting anything.
        local sz room
        sz=$(du -sb "$p" 2>/dev/null | cut -f1); sz=${sz:-0}
        room=$(df -B1 --output=avail "$(dirname "$out")" 2>/dev/null | tail -1 | tr -d ' ')
        if [[ -n "$room" && "$sz" -gt 0 ]] && (( room < sz * 3 + 104857600 )); then
            dlg_err "Not enough free space beside the target to verify safely.\nNeed ~$(( sz * 3 / 1073741824 + 1 ))GB, have $(( room / 1073741824 ))GB on $(dirname "$out").\nNothing was encrypted. Free up space and run lockd again."
            say "verify space short for $p - nothing encrypted"
            continue
        fi
        local vdir; vdir=$(mktemp -d "$(dirname "$out")/.lockd-vf.XXXXXX")
        VFDIR="$vdir"
        local vcmp; vcmp="$vdir/verify"        # non-existent: age writes fresh
        local ok=0
        if age -d -i "$TMPID" -o "$vcmp" "$out" 2>/dev/null; then
            if [[ -d "$p" ]]; then
                local vext="$vdir/extract"
                mkdir -p "$vext"
                tar -xzf "$vcmp" -C "$vext" 2>/dev/null \
                    && diff -r -q --no-dereference "$p" "$vext/$(basename "$p")" >/dev/null 2>&1 \
                    && ok=1
            else
                cmp -s "$vcmp" "$p" && ok=1
            fi
        fi
        if [[ $ok -eq 1 ]]; then
            if [[ $KEEP -eq 1 ]]; then
                say "verified: $out (original kept: --keep)"
                # GUI runs have no stdout - say it where the user is
                notify "original kept (--keep): $(basename "$p")"
            elif [[ -d "$p" ]]; then
                # recursive wipe: shred every regular file, then remove the
                # tree (shred itself refuses directories)
                local f
                while IFS= read -r -d '' f; do shred -uzn1 "$f" 2>/dev/null || true; done \
                    < <(find "$p" -type f -print0)
                rm -rf -- "$p" && say "verified + wiped: $p  ->  $out"
            else
                shred -uzn1 "$p" && say "verified + wiped: $p  ->  $out"
            fi
        else
            rm -rf "$vdir"; VFDIR=""; shred -uzn1 "$out" 2>/dev/null || true
            dlg_err "VERIFICATION FAILED for $p\nThe original was KEPT and the bad ciphertext was destroyed.\nNothing was lost. That is the rule."
            say "VERIFICATION FAILED: $p kept, bad ciphertext destroyed"
            continue
        fi
        rm -rf "$vdir"; VFDIR=""
        made+=("$out")
    done
    (( ${#made[@]} > 0 )) || { say "nothing encrypted"; return 0; }

    # fast-path check: run flag > saved config
    if [[ $FULL_RUN -eq 0 ]] && { [[ $FAST_RUN -eq 1 ]] || [[ $(config_get fast_path) == "1" ]]; }; then
        say "fast path: ${#made[@]} file(s) locked. done."
        return 0
    fi
    send_offers "$pub" "${made[@]}"
    if [[ $NEW_KEY -eq 1 ]]; then
        say "your new public key: $pub"
        say "(phase 2 will offer: email signing, contact-card sharing)"
    fi
}

do_shred() {
    # the wipe rule's machinery, standing alone: secure-wipe any file
    # or directory tree (files inside shredded, tree removed).
    # no confirmation, no victory lap: shred is a monster, and issuing it
    # IS the confirmation. it speaks once, after the fact:
    # "and just like that...gone".
    # (2026-09-06: the yad confirm + per-file pop-ups went away - two
    # dialogs in the face of a user who already decided was one too many)
    local paths=("$@")
    if (( ${#paths[@]} == 0 )); then
        mapfile -t paths < <(dlg_pick "lockd — pick file(s) to wipe")
        (( ${#paths[@]} > 0 )) || die "nothing picked"
    fi
    local p n=0
    for p in "${paths[@]}"; do
        if [[ -d "$p" && ! -L "$p" ]]; then
            # directory: the same recursive wipe the verified encrypt
            # flow uses - shred every regular file inside, then remove
            # the tree. no lockd flag involved; erase means erase.
            local f
            while IFS= read -r -d '' f; do
                shred -uzn1 "$f" 2>/dev/null \
                    || printf 'lockd: survived: %s (shred failed)\n' "$f" >&2
            done < <(find "$p" -type f -print0)
            rm -rf -- "$p" && { say "gone: $p (directory, every file inside)"; n=$((n+1)); } \
                || printf 'lockd: survived: %s (tree removal failed)\n' "$p" >&2
        elif [[ -f "$p" ]]; then
            shred -uzn1 "$p" && { say "gone: $p"; n=$((n+1)); } \
                || printf 'lockd: survived: %s (shred failed)\n' "$p" >&2
        else
            say "skip: $p (not a regular file or directory)"
        fi
    done
    (( n > 0 )) && notify -t 3000 "and just like that...gone"
    return 0
}

do_decrypt() {
    need age; need age-keygen
    [[ -f "$(identity_path)" ]] || die "no default key to unlock"
    TMPID=$(unlock_identity)
    trap 'cleanup_ids; [[ -n "${VFDIR:-}" ]] && rm -rf "${VFDIR}"; [[ -n "${STAGE:-}" ]] && rm -rf "${STAGE}"; VFDIR=""; STAGE=""' EXIT
    local paths=("$@")
    if (( ${#paths[@]} == 0 )); then
        mapfile -t paths < <(dlg_pick "lockd — pick .age to decrypt" "age files | *.age")
        (( ${#paths[@]} > 0 )) || die "nothing picked"
    fi
    local p out
    for p in "${paths[@]}"; do
        [[ -f "$p" ]] || { say "skip: $p (missing)"; continue; }
        if [[ "$p" == *.tar.gz.age ]]; then
            # directory archive: stream-decrypt straight into extraction -
            # the plaintext archive never exists as a file, the tree comes
            # back in place, no residue (machiner spec: seamless, tight,
            # safe)
            local asz room stage root target moved=0
            asz=$(stat -c %s "$p" 2>/dev/null || echo 0)
            room=$(df -B1 --output=avail "$(dirname "$p")" 2>/dev/null | tail -1 | tr -d ' ')
            if [[ -n "$room" ]] && (( asz > 0 && room < asz * 3 + 104857600 )); then
                dlg_err "Not enough free space beside $p to restore the tree.\nNeed ~$(( asz * 3 / 1073741824 + 1 ))GB, have $(( room / 1073741824 ))GB. Nothing was changed."
                continue
            fi
            stage=$(mktemp -d "$(dirname "$p")/.lockd-ex.XXXXXX")
            STAGE="$stage"
            if ! age -d -i "$TMPID" "$p" 2>/dev/null | tar -xzf - -C "$stage"; then
                dlg_err "Restore failed - archive may be corrupt or extraction ran out of space.\nThe .age source is untouched. Partial output removed."
                rm -rf "$stage"; STAGE=""
                continue
            fi
            # move the tree into place - NEVER over an existing path. On a
            # name conflict the restore is KEPT (staging dir) and pointed
            # at, so nothing can be lost.
            while IFS= read -r -d '' root; do
                [[ -n "$root" ]] || continue
                target="$(dirname "$p")/$(basename "$root")"
                if [[ -e "$target" ]]; then
                    say "conflict: $target already exists - restore kept at $root"
                    notify "restore conflict - nothing overwritten"
                    continue
                fi
                mv -- "$root" "$target" \
                    && { say "restored: $target"; RESTORED="$target"; moved=$((moved+1)); }
            done < <(find "$stage" -mindepth 1 -maxdepth 1 -print0)
            if [[ -z "$(ls -A "$stage" 2>/dev/null)" ]]; then
                rm -rf "$stage"; STAGE=""
            else
                STAGE=""   # conflict: staging kept on purpose - protect it from the trap
            fi
            (( moved > 0 )) || say "decrypted: $p (see messages above)"
            continue
        fi
        case "$p" in
            *.age) out="${p%.age}" ;;
            *)     out="${p}.decrypted" ;;
        esac
        age -d -i "$TMPID" -o "$out" "$p"
        RESTORED="$out"
        say "decrypted: $p  ->  $out"
    done
    if [[ $OPEN -eq 1 ]]; then
        if [[ -n "${RESTORED:-}" && -e "$RESTORED" ]]; then
            notify "unlocked: $(basename "$RESTORED")"
            xdg-open "$RESTORED" >/dev/null 2>&1 & disown
        fi
    fi
    if dlg_q "Shred the source .age file(s) now?\n(the decrypted output stays, of course)"; then
        for p in "${paths[@]}"; do [[ -f "$p" ]] && shred -uzn1 "$p" && say "wiped: $p"; done
    fi
}

main() {
    local args=()
    while (( $# > 0 )); do
        case "$1" in
            -k|--keep)   KEEP=1 ;;
            -f|--fast)   FAST_RUN=1 ;;
            --full)      FULL_RUN=1 ;;
            -d|--decrypt) DECRYPT=1 ;;
            --open)       OPEN=1 ;;
            --shred)     SHRED_MODE=1 ;;
            --selftest)  do_selftest; exit $? ;;
            --print-backend) dlg_backend; printf '%s\n' "$DLG"; exit 0 ;;
            --ctx-script)
                shift
                print_ctx_script "${1:-}" \
                    || { printf 'lockd: --ctx-script needs encrypt|decrypt|shred\n' >&2; exit 1; }
                exit 0 ;;
            -h|--help)   usage; exit 0 ;;
            -*)          die "unknown flag: $1 (see --help)" ;;
            *)           args+=("$1") ;;
        esac
        shift
    done
    need script; need shred; need cmp
    # the key file defends itself regardless of umask or home perms:
    # dir 700, identity 600 (ciphertext stays shareable - that is the
    # point of encryption; the KEY is the crown jewel)
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR" 2>/dev/null || true
    local idnow; idnow=$(identity_path)
    [[ -f "$idnow" ]] && chmod 600 "$idnow" 2>/dev/null || true
    if [[ $SHRED_MODE -eq 1 ]]; then do_shred "${args[@]}";
    elif [[ $DECRYPT -eq 1 ]]; then do_decrypt "${args[@]}"; else do_encrypt "${args[@]}"; fi
}

main "$@"
